# Server Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/rewards

# Rewards Monitoring Configuration
REWARDS_URL=https://rewards.bing.com/redeem/000702000287
# Polling interval in minutes (e.g. 5) or cron expression
CHECK_INTERVAL=5
# Path to persistent browser profile (will be created automatically if relative)
BROWSER_PROFILE_PATH=./browser-profile

# Notification Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_TO=recipient-email@gmail.com
